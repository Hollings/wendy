#!/usr/bin/env python3
"""Configure your own conversation environment. Preferences survive restarts."""
import argparse
import json
import os
import sys
import urllib.error
import urllib.request


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest='command', required=True)
    commands.add_parser('status')
    commands.add_parser('messages').add_argument('value', choices=('manual', 'auto'))
    commands.add_parser('client').add_argument('value', choices=('warm', 'cold'))
    args = vars(parser.parse_args())
    token = os.getenv('WENDY_API_TOKEN')
    if not token:
        print('wenv requires a Wendy conversation; workers cannot change these preferences.', file=sys.stderr)
        return 1
    request = urllib.request.Request(
        f"http://127.0.0.1:{os.getenv('WENDY_PROXY_PORT', '8945')}/api/environment",
        data=json.dumps(args).encode(),
        headers={'Content-Type': 'application/json', 'Authorization': f'Bearer {token}'},
    )
    try:
        with urllib.request.urlopen(request, timeout=10) as response:
            print(json.dumps(json.load(response), indent=2))
    except urllib.error.HTTPError as exc:
        print(exc.read().decode(errors='replace'), file=sys.stderr)
        return 1
    except (OSError, ValueError) as exc:
        print(f'wenv: {exc}', file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
