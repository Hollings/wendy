#!/usr/bin/env python3
"""Kill a running bead agent and close its bead.

Use this when you actually want a background agent to STOP. `bd close` alone
just marks the bead closed and waits for the orchestrator to notice; bd-kill
goes through the internal API to terminate the subprocess immediately.

Usage:
    bd-kill bd-abc123                 # kill one bead
    bd-kill bd-abc123 -r "wrong dir"  # kill with a reason in the bd comment
    bd-kill --list                    # show running beads in this channel
"""
import argparse
import json
import os
import sys
import urllib.error
import urllib.request


def _api(port: str, path: str, body: dict | None = None) -> dict:
    url = f"http://localhost:{port}{path}"
    if body is None:
        req = urllib.request.Request(url)
    else:
        req = urllib.request.Request(
            url,
            data=json.dumps(body).encode(),
            headers={"Content-Type": "application/json"},
            method="POST",
        )
    try:
        with urllib.request.urlopen(req) as resp:
            return json.loads(resp.read().decode())
    except urllib.error.HTTPError as e:
        try:
            return json.loads(e.read().decode())
        except json.JSONDecodeError:
            return {"error": f"HTTP {e.code}"}


def main() -> None:
    p = argparse.ArgumentParser(description="Kill a running bead agent")
    p.add_argument("task_id", nargs="?", help="Bead task ID (e.g. bd-abc123)")
    p.add_argument("-r", "--reason", default="killed via bd-kill",
                   help="Reason recorded in the bead comment")
    p.add_argument("-l", "--list", action="store_true",
                   help="List running beads in this channel and exit")
    args = p.parse_args()

    port = os.environ.get("WENDY_PROXY_PORT", "8945")
    channel_id = os.environ.get("WENDY_CHANNEL_ID")

    if args.list or not args.task_id:
        params = ""
        # The active_beads endpoint takes a folder name; if we don't know it
        # we fetch all and let the caller pick.
        result = _api(port, f"/api/active_beads{params}")
        agents = result.get("agents") or []
        if not agents:
            print("no active beads")
            return
        for a in agents:
            mins, secs = divmod(a["elapsed_seconds"], 60)
            print(f"{a['task_id']:14s}  {mins:>3d}m{secs:02d}s  [{a['channel']}]  {a['title']}")
        if not args.task_id:
            sys.exit(0 if args.list else 1)

    body: dict = {"task_id": args.task_id, "reason": args.reason}
    if channel_id:
        body["channel_id"] = channel_id

    result = _api(port, "/api/cancel_bead", body)
    if result.get("success"):
        print(result.get("message", "killed"))
    else:
        print(f"error: {result.get('message') or result.get('error') or 'unknown'}",
              file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
