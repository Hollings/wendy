# =============================================================================
# wendy (bot service)
# =============================================================================

# Discord bot token
DISCORD_TOKEN=

# Channel configuration (JSON array)
# Each entry: id, name, mode (chat|full), model (opus|sonnet|haiku), beads_enabled
WENDY_CHANNEL_CONFIG='[{"id":"1234567890123456789","name":"coding","mode":"full","model":"opus","beads_enabled":true}]'

# Deploy tokens for wendy-web service (must match DEPLOY_TOKEN in sites.env)
WENDY_DEPLOY_TOKEN=
WENDY_GAMES_TOKEN=    # can be same as WENDY_DEPLOY_TOKEN

# Gemini API key for /api/analyze_file (images, audio, video)
GEMINI_API_KEY=

# Optional historical-memory pilot (see docs/memory-operations.md)
WENDY_MEMORY_ENABLED=false
WENDY_MEMORY_URL=http://127.0.0.1:8950
WENDY_MEMORY_SERVICE_TOKEN=
WENDY_MEMORY_MODEL=sonnet
WENDY_MEMORY_RESEARCHER=gemini
WENDY_MEMORY_GEMINI_MODEL=gemini-3.5-flash
# Optional DeepSeek researcher (select WENDY_MEMORY_RESEARCHER=deepseek)
DEEPSEEK_API_KEY=
WENDY_MEMORY_DEEPSEEK_MODEL=deepseek-flash
WENDY_MEMORY_DEEPSEEK_EFFORT=low
HINDSIGHT_URL=http://127.0.0.1:8888
HINDSIGHT_API_KEY=

# Bot identity
WENDY_BOT_NAME=Wendy
# Internal endpoint the bot uses to reach the wendy-web service
WENDY_WEB_URL=http://localhost:8910
# Public base URL used in the system prompt and webhook URLs
WENDY_PUBLIC_URL=https://wendy.monster

# Guild IDs for full message logging (comma-separated Discord guild IDs)
# MESSAGE_LOGGER_GUILDS=

# Claude OAuth token -- replaces interactive `claude login`
# Generate with: claude setup-token
# Also requires {"hasCompletedOnboarding": true} in ~/.claude.json (entrypoint handles this)
CLAUDE_CODE_OAUTH_TOKEN=

# Worker policy (global across all channels and threads; persists over restarts)
WENDY_TASK_DEFAULT_MODEL=opus
WENDY_TASK_MODEL_LIMITS='{"fable":10}'
WENDY_TASK_QUOTA_TIMEZONE=America/Los_Angeles

# Retain idle conversation clients (message delivery stays manual by default).
WENDY_PERSISTENT_CLIENTS=1
WENDY_CLIENT_IDLE_SECONDS=600
WENDY_WARM_CLIENT_LIMIT=4

# Claude session sync
# CLAUDE_SYNC_KEY=

# =============================================================================
# wendy-web (sites + games + brain)
# =============================================================================

# Deploy token -- must match WENDY_DEPLOY_TOKEN above
DEPLOY_TOKEN=

# Brain feed credentials
BRAIN_ACCESS_CODE=      # code users type to log in (e.g. wendyiscool)
BRAIN_SECRET=           # signing secret: openssl rand -hex 32

# GitHub webhook signature validation (optional)
WEBHOOK_SECRET=
