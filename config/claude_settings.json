{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /app/config/hooks/boundary.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Use wtask start \"title\" -d \"goal, paths, constraints, verification\" --model opus. Workers must not create tasks. Docs: /app/config/docs/bd_usage.md' >&2 && exit 2"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|Grep|Glob|WebSearch|WebFetch|mcp__memory__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /app/config/hooks/boundary.py"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "/app/config/hooks/remind_analyze_file.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/app/config/hooks/log_bash_tool.sh",
            "async": true
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/app/config/hooks/pre_compact.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /app/config/hooks/boundary.py"
          }
        ]
      }
    ]
  }
}
